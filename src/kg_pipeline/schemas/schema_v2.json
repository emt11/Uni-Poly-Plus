{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uni-poly.local/polymer-kg/schema-v2.json",
  "title": "Polymer literature extraction schema v2.0",
  "type": "object",
  "required": ["article", "evidence_records", "literature_samples", "dataset_links", "warnings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "article": {
      "type": "object",
      "required": ["article_id", "title", "doi", "year", "journal"],
      "properties": {"article_id": {"type": "string"}}
    },
    "evidence_records": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "literature_samples": {"type": "array", "items": {"$ref": "#/$defs/sample"}},
    "dataset_links": {"type": "array"},
    "warnings": {"type": "array"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "chunk_id", "sentence"],
      "properties": {
        "evidence_id": {"type": "string"},
        "chunk_id": {"type": "string"},
        "sentence": {"type": ["string", "null"]}
      }
    },
    "sample": {
      "type": "object",
      "required": [
        "sample_id", "aliases", "identity_evidence_refs", "composition_assertions",
        "sequence_distribution_assertions", "chain_architecture_assertions",
        "molecular_weight_measurements", "polymerization_events"
      ],
      "properties": {
        "sample_id": {"type": "string"},
        "aliases": {"type": "array"},
        "identity_evidence_refs": {"type": "array"},
        "composition_assertions": {"type": "array"},
        "sequence_distribution_assertions": {"type": "array"},
        "chain_architecture_assertions": {"type": "array"},
        "molecular_weight_measurements": {"type": "array"},
        "polymerization_events": {"type": "array"}
      }
    }
  }
}
