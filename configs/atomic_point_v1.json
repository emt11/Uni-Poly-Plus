{
  "schema": "atomic-point-cloud-v1-config",
  "architecture": "MIPS-KFuse-Atomic-PC-v1",
  "hidden_dim": 256,
  "output_dim": 512,
  "num_layers": 4,
  "k_neighbors": 24,
  "num_heads": 8,
  "element_embedding_dim": 64,
