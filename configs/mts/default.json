{
  "schema_version": "mts-config-v3",
  "route": "MIPS-Trimer-SCAGE",
  "route_short_name": "MTS",
  "topology_representation": "canonical_lifted",
  "baseline": "MIPS-Trimer-SCAGE",
  "architecture": "canonical_periodic_T1_msta_last2_star_rbf_trimer_mcl_md200",
  "modalities": ["graph"],
  "mips_core": "paper_corrected",
  "mips_variant": "O8",
  "atom_feature_mode": "mips137",
  "layers": 6,
  "hidden_dim": 512,
  "heads": 8,
  "ffn_dim": 2048,
  "max_hops": 2,
  "topology_attention_variant": "msta_last2",
  "msta_layer_indices": [4, 5],
  "msta_local_spd": [0, 1],
  "msta_context_spd": [0, 1, 2],
  "msta_share_relation_dropout": true,
  "msta_local_output_bias": false,
  "msta_local_output_init": "zero",
  "boundary_threshold": 5,
  "attachment_site_policy": "two_sites_shared_boundary_allowed",
  "mismatched_bond_policy": "single",
  "boundary_distance_algorithm": "expanded_graph_shortest_path",
  "multimer_builder_version": 2,
  "attention_direction": "key_source_query_target",
  "attention_scale": "head_dim",
  "norm_mode": "post",
  "activation": "relu",
  "spd_bias_mode": "per_head",
  "path_bias_mode": "per_head_single_path_node",
  "star_distance_rbf": {
    "num_kernels": 32,
    "range_angstrom": [0.0, 3.0],
    "asymmetry_max_angstrom": 0.15,
    "projection_init": "zero"
  },
  "trimer": {
    "protocol": "etkdgv3x4-mmff94-relax200-lowest-finite-v1",
    "builder_version": 12,
    "num_candidates": 4,
    "max_heavy_atoms": 384,
    "large_molecule_policy": "rdkit_2d_diagnostic_mcl_star3d_disabled",
    "etkdg_use_random_coords": false,
    "etkdg_max_iterations": 42,
    "etkdg_timeout_seconds": 60,
    "etkdg_failure_retry": {
      "num_candidates": 2,
      "use_random_coords": true,
      "max_iterations": 200
    },
    "mmff_max_iterations": 200,
    "mmff_variant": "MMFF94",
    "require_mmff_convergence": false,
    "acceptance": "finite_3d_coordinates_and_finite_mmff_energy",
    "selection": "lowest_finite_post_relaxation_energy",
    "mcl_layers": 2,
    "distance_percentiles": [0.2, 0.5],
    "query_scope": "central_ru",
    "key_value_scope": "full_trimer"
  },
  "descriptor": {
    "components": ["MD200"],
    "protocol": "source_star_sub",
    "fusion": "graph_level_low_capacity_residual"
  },
  "pretraining": {
    "id": "mts_joint_pretraining",
    "name": "MTS Joint Pretraining",
    "dataset": "PI1M_v2",
    "optimizer_steps": 20000,
    "mask_ratio": 0.30,
    "angle_bins": 20,
    "angle_focal_gamma": 2.0,
    "loss_weights": {
      "masked_atom": 1.0,
      "trimer_bond_angle": 0.25
    },
    "default_topology_identity": "T1_msta_last2",
    "g_family_objective": "masked_atom_only",
    "adam": {
      "beta1": 0.9,
      "beta2": 0.98,
      "eps": 1e-8,
      "weight_decay": 0.0
    },
    "lr": 0.0002,
    "warmup_steps": 2000,
    "scheduler": "polynomial",
    "scheduler_power": 1,
    "end_lr": 1e-9,
    "gradient_clip": -1
  },
  "stage1": {
    "id": "mts_joint_pretraining",
    "name": "MTS Joint Pretraining"
  },
  "stage2": {
    "id": "mts_property_finetune",
    "name": "MTS Property Fine-tuning"
  },
  "finetune": {
    "id": "mts_property_finetune",
    "name": "MTS Property Fine-tuning"
  },
  "feature_schema": "mts-canonical-periodic-feature-v3",
  "trimer_cache_schema": "mips-trimer-scage-trimer-v8",
  "trimer_lmdb_schema": "mips-trimer-scage-trimer-lmdb-v6",
  "cache_layout_schema": "mips-trimer-scage-lmdb-layout-v2",
  "topology_lmdb_schema": "mts-canonical-periodic-topology-lmdb-v3",
  "lga_schema_version": 2,
  "cache_bundle_schema": "mts-canonical-cache-bundle-v3",
  "trimer_builder_version": 12,
  "checkpoint_schema": "mts-model-v3"
}
